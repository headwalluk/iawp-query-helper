#. Plugin Name of the plugin
#: iawp-query-helper.php
msgid "IAWP Query Helper"
msgstr "IAWP Query Helper"

#. Plugin URI of the plugin
#: iawp-query-helper.php
msgid "https://headwall-hosting.com/plugins/iawp-query-helper/"
msgstr "https://headwall-hosting.com/plugins/iawp-query-helper/"

#. Description of the plugin
#: iawp-query-helper.php
msgid "Read-only REST routes and Abilities for querying Independent Analytics visitor and view metrics, built for AI agents."
msgstr "Trasy REST tylko do odczytu oraz funkcje umożliwiające wyszukiwanie wskaźników dotyczących odwiedzających i wyświetleń w usłudze Independent Analytics, stworzone z myślą o agentach AI."

#. Author of the plugin
#: iawp-query-helper.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: iawp-query-helper.php
msgid "https://headwall-hosting.com/a-web-guys-blog/"
msgstr "https://headwall-hosting.com/a-web-guys-blog/"

#: functions-private.php:68
msgid "You need permission to view all Independent Analytics data."
msgstr "Aby wyświetlić wszystkie dane z serwisu Independent Analytics, potrzebujesz uprawnień."

#: includes/class-abilities.php:82
msgctxt "ability category label; product name"
msgid "Independent Analytics"
msgstr "Niezależne analizy"

#: includes/class-abilities.php:83
msgid "Read-only queries over Independent Analytics visitor and view data."
msgstr "Zapytania tylko do odczytu dotyczące danych o odwiedzających i wyświetleniach w serwisie Independent Analytics."

#: includes/class-date-range-resolver.php:92
msgid "Use either period, or start and end, not both."
msgstr "Należy użyć albo kropki, albo daty początkowej i końcowej, ale nie obu jednocześnie."

#: includes/class-date-range-resolver.php:94
msgid "end needs a start date as well."
msgstr "Koniec również wymaga podania daty rozpoczęcia."

#: includes/class-date-range-resolver.php:163
msgid "start must be a real date in Y-m-d format."
msgstr "Wartość „start” musi być rzeczywistą datą w formacie Y-m-d."

#: includes/class-date-range-resolver.php:165
msgid "end must be a real date in Y-m-d format."
msgstr "Wartość „end” musi być prawdziwą datą w formacie Y-m-d."

#: includes/class-date-range-resolver.php:167
msgid "start must not be after end."
msgstr "Początek nie może następować po końcu."

#: includes/class-date-range-resolver.php:235
msgid "Unknown period."
msgstr "Okres nieznany."

#. translators: %d: maximum days allowed in one range.
#: includes/class-date-range-resolver.php:313
#, php-format
msgid "A range can cover at most %d day. Split this one into shorter ranges."
msgid_plural "A range can cover at most %d days. Split this one into shorter ranges."
msgstr[0] "Przedział może obejmować maksymalnie %d dzień. Podziel ten przedział na krótsze przedziały."
msgstr[1] "Przedział może obejmować maksymalnie %d dni. Podziel ten przedział na krótsze przedziały."
msgstr[2] "Przedział może obejmować maksymalnie %d dni. Podziel ten przedział na krótsze przedziały."

#: includes/class-dimension-query.php:134
#: includes/queries/class-top-posts-query.php:96
msgid "Metric to rank by, highest first."
msgstr "Jednostka miary, według której ma być sortowana lista, od największej wartości."

#: includes/class-executor.php:103
msgid "There is no query with that name."
msgstr "Nie ma zapytania o tej nazwie."

#: includes/class-executor.php:105
msgid "Independent Analytics is not active on this site, or its tables are missing."
msgstr "Narzędzie Independent Analytics nie działa na tej stronie lub brakuje jego tabel."

#: includes/class-executor.php:109
msgid "Independent Analytics is updating its database. Retry in a few minutes."
msgstr "Firma Independent Analytics aktualizuje swoją bazę danych. Spróbuj ponownie za kilka minut."

#: includes/class-executor.php:116
msgid "This query needs a licensed copy of Independent Analytics Pro."
msgstr "To zapytanie wymaga licencjonowanej kopii programu Independent Analytics Pro."

#. translators: %d: maximum row offset.
#: includes/class-executor.php:157
#, php-format
msgid "Paging stops after %d row. Narrow the range or add a filter instead."
msgid_plural "Paging stops after %d rows. Narrow the range or add a filter instead."
msgstr[0] "Paginacja kończy się po %d wierszu. Zawęź zakres lub dodaj filtr."
msgstr[1] "Paginacja kończy się po %d wierszach. Zawęź zakres lub dodaj filtr."
msgstr[2] "Paginacja kończy się po %d wierszach. Zawęź zakres lub zastosuj filtr."

#. translators: %s: plugin name.
#: includes/class-plugin.php:240
#, php-format
msgid "%s needs Independent Analytics (free or Pro) to be active. Its REST routes and abilities are switched off until then."
msgstr "Aby wtyczka %s działała, konieczne jest aktywowanie usługi Independent Analytics (wersja bezpłatna lub Pro). Do tego momentu jej trasy REST i funkcje są wyłączone."

#. translators: 1: plugin name, 2: IAWP database version, 3: highest tested version.
#: includes/class-plugin.php:251
#, php-format
msgid "%1$s has not been tested with Independent Analytics database version %2$d (tested up to %3$d). Queries still run; check for an update."
msgstr "%1$s nie zostało przetestowane z wersją bazy danych Independent Analytics %2$d (przetestowano do wersji %3$d). Zapytania nadal działają; sprawdź dostępność aktualizacji."

#: includes/class-query-runner.php:65
msgid "Other analytics queries are already running on this site. Retry shortly."
msgstr "W tej witrynie są już uruchomione inne zapytania analityczne. Spróbuj ponownie za chwilę."

#. translators: %d: seconds.
#: includes/class-query-runner.php:242
#, php-format
msgid "The query took longer than %d second and was stopped. Narrow the date range or add a filter."
msgid_plural "The query took longer than %d seconds and was stopped. Narrow the date range or add a filter."
msgstr[0] "Zapytanie trwało dłużej niż %d sekundę i zostało przerwane. Zawęź zakres dat lub dodaj filtr."
msgstr[1] "Zapytanie trwało dłużej niż %d sekundy i zostało przerwane. Zawęź zakres dat lub dodaj filtr."
msgstr[2] "Zapytanie trwało dłużej niż %d sekund i zostało przerwane. Zawęź zakres dat lub dodaj filtr."

#: includes/class-query-runner.php:252
msgid "The analytics query failed. The error has been logged on the server."
msgstr "Zapytanie analityczne zakończyło się niepowodzeniem. Błąd został zarejestrowany na serwerze."

#: includes/class-query.php:210
msgid "Preset date range, defined as on the Independent Analytics dashboard, in the site timezone. year_to_date is the dashboard's \"This Year\". Defaults to last_30_days. Do not combine with start/end."
msgstr "Z góry ustalony przedział czasowy, zdefiniowany zgodnie z pulpitem nawigacyjnym Independent Analytics, w strefie czasowej witryny. year_to_date odpowiada opcji „W tym roku” na pulpicie nawigacyjnym. Wartością domyślną jest last_30_days. Nie należy łączyć tej opcji z opcjami start/end."

#: includes/class-query.php:215
msgid "First day, Y-m-d, site timezone, inclusive. Use instead of period."
msgstr "Pierwszy dzień, Y-m-d, strefa czasowa serwisu, włącznie. Należy używać zamiast kropki."

#: includes/class-query.php:220
msgid "Last day, Y-m-d, site timezone, inclusive. Defaults to today when start is given."
msgstr "Ostatni dzień, Y-m-d, strefa czasowa serwisu, włącznie. Jeśli podano datę rozpoczęcia, domyślnie przyjmowana jest dzisiejsza data."

#: includes/class-query.php:226
msgid "Also report a comparison range. previous_year is the same dates one year earlier (use with year_to_date for year-on-year); previous_period is the same number of days immediately before."
msgstr "Należy również podać zakres porównawczy. „previous_year” oznacza ten sam okres z poprzedniego roku (należy stosować wraz z „year_to_date” w celu porównania rok do roku); „previous_period” oznacza ten sam okres w dniach bezpośrednio poprzedzający."

#: includes/class-query.php:254
msgid "Page of results, from 1. Check meta.pagination.has_more."
msgstr "Strona wyników, od 1. Sprawdź, czy meta.pagination.has_more ma wartość „true”."

#: includes/class-query.php:245
#: includes/class-query.php:261
msgid "Rows per page."
msgstr "Liczba wierszy na stronie."

#: includes/class-query.php:289
msgid "Query name, resolved ranges, pagination and IAWP version details."
msgstr "Nazwa zapytania, ustalone zakresy, paginacja oraz szczegóły dotyczące wersji IAWP."

#: includes/class-query.php:299
msgid "The same series for the comparison range, or null when not comparing."
msgstr "Ta sama seria dla zakresu porównawczego lub wartość zerowa, jeśli nie przeprowadza się porównania."

#: includes/class-query.php:348
msgid "Values for the comparison range, or null when not comparing."
msgstr "Wartości z zakresu porównawczego lub wartość null, jeśli nie przeprowadza się porównania."

#: includes/class-query.php:353
msgid "Percentage change from previous to current, to 1 decimal place. A metric is null when its previous value was 0."
msgstr "Zmiana procentowa między poprzednią a bieżącą wartością, z dokładnością do jednego miejsca po przecinku. Wskaźnik ma wartość null, jeśli jego poprzednia wartość wynosiła 0."

#: includes/queries/class-campaigns-query.php:88
msgctxt "ability label; marketing campaigns tracked with UTM parameters"
msgid "Campaigns"
msgstr "Kampanie"

#: includes/queries/class-campaigns-query.php:99
msgid "Traffic from UTM-tagged campaign links for a date range, from Independent Analytics. dimension=campaign gives one row per distinct campaign (landing page, source, medium, campaign, term, content); utm_source, utm_medium, utm_campaign or landing_page group by that one parameter. Each row has views, visitors, sessions, bounce rate, views per session and average session length, matching the dashboard's Campaigns tables. Untagged traffic is not included. Paged."
msgstr "Ruch z linków kampanii oznaczonych tagami UTM dla danego przedziału czasowego, pochodzący z serwisu Independent Analytics. Parametr „dimension=campaign” generuje jeden wiersz dla każdej odrębnej kampanii (strona docelowa, źródło, medium, kampania, fraza, treść); parametry „utm_source”, „utm_medium”, „utm_campaign” lub „landing_page” grupują dane według tego jednego parametru. Każdy wiersz zawiera dane dotyczące wyświetleń, odwiedzających, sesji, współczynnika odrzuceń, liczby wyświetleń na sesję oraz średniej długości sesji, zgodne z tabelami „Kampanie” w panelu kontrolnym. Ruch bez tagów nie jest uwzględniony. Stronicowanie."

#: includes/queries/class-campaigns-query.php:117
msgid "Group by whole campaign, or by one UTM parameter."
msgstr "Pogrupuj według całej kampanii lub według jednego parametru UTM."

#: includes/queries/class-campaigns-query.php:183
msgid "Title of the page the campaign link pointed to."
msgstr "Tytuł strony, do której prowadził link kampanii."

#: includes/queries/class-catalogue-query.php:62
msgctxt "ability label; list of available analytics queries and site settings"
msgid "Analytics catalogue"
msgstr "Katalog analityczny"

#: includes/queries/class-catalogue-query.php:73
msgid "Call this first. Describes the Independent Analytics data on this site: timezone, week start, store currency, the first day with data, whether Independent Analytics Pro is active, the limits on date ranges and page sizes, and every analytics query available with what it is for. Takes no parameters."
msgstr "Najpierw wywołaj tę funkcję. Opisuje dane serwisu Independent Analytics dostępne na tej stronie: strefę czasową, początek tygodnia, walutę sklepu, pierwszy dzień, dla którego dostępne są dane, informację o tym, czy usługa Independent Analytics Pro jest aktywna, ograniczenia dotyczące zakresów dat i rozmiarów stron, a także wszystkie dostępne zapytania analityczne wraz z opisem ich przeznaczenia. Nie przyjmuje żadnych parametrów."

#: includes/queries/class-catalogue-query.php:121
msgid "Store currency, when WooCommerce is active."
msgstr "Waluta sklepu, gdy wtyczka WooCommerce jest aktywna."

#: includes/queries/class-catalogue-query.php:125
msgid "First day with recorded views, Y-m-d, site timezone. Ranges before it return zeros."
msgstr "Pierwszy dzień, w którym zarejestrowano wyświetlenia, r-m-d, strefa czasowa serwisu. Wartości z wcześniejszych okresów to zera."

#: includes/queries/class-cities-query.php:40
msgctxt "ability label; visitor locations by city"
msgid "Cities"
msgstr "Miasta"

#: includes/queries/class-cities-query.php:51
msgid "Traffic by visitor city for a date range, from Independent Analytics: city, region, country code and country, with views, visitors, sessions, bounce rate, views per session and average session length. Matches the dashboard's cities table. Filter with country_code to see one country. Visitors must not be summed across rows. Paged."
msgstr "Ruch według miasta odwiedzających w wybranym przedziale czasowym, na podstawie danych z Independent Analytics: miasto, region, kod kraju i kraj, wraz z liczbą wyświetleń, odwiedzających, sesji, współczynnikiem odrzuceń, liczbą wyświetleń na sesję oraz średnim czasem trwania sesji. Dane odpowiadają tabeli miast na pulpicie nawigacyjnym. Aby wyświetlić dane dotyczące jednego kraju, należy zastosować filtr według „country_code”. Liczba odwiedzających nie może być sumowana w wierszach. Strony są paginowane."

#: includes/queries/class-cities-query.php:68
msgid "Only cities in this country, by ISO 3166-1 alpha-2 code, such as GB."
msgstr "Tylko miasta w tym kraju, zgodnie z kodem ISO 3166-1 alpha-2, np. GB."

#: includes/queries/class-cities-query.php:131
msgid "Region, state or county."
msgstr "Region, stan lub hrabstwo."

#: includes/queries/class-countries-query.php:40
msgctxt "ability label; visitor locations by country"
msgid "Countries"
msgstr "Kraje"

#: includes/queries/class-countries-query.php:51
msgid "Traffic by visitor country for a date range, from Independent Analytics: country code, country name and continent, with views, visitors, sessions, bounce rate, views per session and average session length. Matches the dashboard's countries table. Sessions with no known location are left out. Visitors must not be summed across rows. Paged."
msgstr "Ruch według kraju pochodzenia odwiedzających w wybranym przedziale czasowym, na podstawie danych z serwisu Independent Analytics: kod kraju, nazwa kraju i kontynent, wraz z liczbą wyświetleń, odwiedzających, sesji, współczynnikiem odrzuceń, liczbą wyświetleń na sesję oraz średnim czasem trwania sesji. Dane odpowiadają tabeli krajów w panelu kontrolnym. Sesje bez znanej lokalizacji nie są uwzględniane. Liczby odwiedzających nie mogą być sumowane w wierszach. Stronicowanie."

#: includes/queries/class-countries-query.php:107
msgid "ISO 3166-1 alpha-2 code."
msgstr "Kod ISO 3166-1 typu alfa-2."

#: includes/queries/class-devices-query.php:52
msgctxt "ability label; visitor device type, operating system or browser"
msgid "Devices"
msgstr "Urządzenia"

#: includes/queries/class-devices-query.php:63
msgid "Traffic by device for a date range, from Independent Analytics. dimension=device_type gives Desktop, Mobile and Tablet; os gives operating systems; browser gives browsers. Each row has views, visitors, sessions, bounce rate, views per session and average session length, matching the dashboard's Devices tables. Visitors must not be summed across rows. Paged."
msgstr "Ruch według urządzeń w wybranym przedziale czasowym, na podstawie danych z Independent Analytics. Wymiar „device_type” obejmuje komputery stacjonarne, urządzenia mobilne i tablety; wymiar „os” obejmuje systemy operacyjne; wymiar „browser” obejmuje przeglądarki. Każdy wiersz zawiera dane dotyczące wyświetleń, odwiedzających, sesji, współczynnika odrzuceń, liczby wyświetleń na sesję oraz średniej długości sesji, co odpowiada tabelom „Urządzenia” w panelu kontrolnym. Liczby odwiedzających nie mogą być sumowane w poszczególnych wierszach. Stronicowanie."

#: includes/queries/class-devices-query.php:81
msgid "Which device attribute to group by."
msgstr "Według jakiego atrybutu urządzenia ma odbywać się grupowanie."

#: includes/queries/class-devices-query.php:138
msgid "Device type, operating system or browser, depending on dimension."
msgstr "Typ urządzenia, system operacyjny lub przeglądarka – w zależności od wymiaru."

#: includes/queries/class-referrer-types-query.php:40
msgctxt "ability label; categories of traffic source such as search or social"
msgid "Referrer types"
msgstr "Typy odsyłaczy"

#: includes/queries/class-referrer-types-query.php:51
msgid "Traffic split by source category for a date range, from Independent Analytics: Search, Social, AI, Direct, Referrer (other websites) and Ad, each with views, visitors, sessions, bounce rate, views per session and average session length. Matches the dashboard's Referrer Types table. Use it for \"how much traffic comes from search?\" questions; use referrers for individual sites."
msgstr "Podział ruchu według kategorii źródeł dla wybranego przedziału czasowego, na podstawie danych z Independent Analytics: wyszukiwarki, media społecznościowe, sztuczna inteligencja, ruch bezpośredni, strony odsyłające (inne witryny) oraz reklamy – dla każdej kategorii podano liczbę wyświetleń, odwiedzających, sesji, współczynnik odrzuceń, liczbę wyświetleń na sesję oraz średnią długość sesji. Odpowiada tabeli „Typy stron odsyłających” na pulpicie nawigacyjnym. Wykorzystaj te dane, aby odpowiedzieć na pytania typu „ile ruchu pochodzi z wyszukiwarek?”; dane dotyczące stron odsyłających wykorzystaj w odniesieniu do poszczególnych witryn."

#: includes/queries/class-referrers-query.php:48
msgctxt "ability label; websites that sent visitors"
msgid "Referrers"
msgstr "Źródła odesłań"

#: includes/queries/class-referrers-query.php:59
msgid "Traffic by referring source for a date range, from Independent Analytics: each row is a referrer (such as Google, Facebook, an AI assistant, or Direct) with its domain and type, plus views, visitors, sessions, bounce rate, views per session and average session length. Matches the dashboard's Referrers table. Filter by referrer_type to see, for example, only Search or only AI. Visitors must not be summed across rows. Paged."
msgstr "Ruch według źródła odesłania dla wybranego przedziału czasowego, na podstawie danych z Independent Analytics: każdy wiersz odpowiada jednemu źródłu odesłania (np. Google, Facebook, asystent AI lub „Bezpośrednio”) wraz z jego domeną i typem, a także liczbą wyświetleń, odwiedzających, sesji, współczynnikiem odrzuceń, liczbą wyświetleń na sesję oraz średnim czasem trwania sesji. Odpowiada tabeli „Źródła odesłań” na pulpicie nawigacyjnym. Filtruj według „referrer_type”, aby wyświetlić na przykład tylko wyniki z wyszukiwarki lub tylko z asystenta AI. Liczba odwiedzających nie może być sumowana w różnych wierszach. Stronicowanie."

#: includes/queries/class-referrers-query.php:76
msgid "Only referrers of this type."
msgstr "Tylko osoby polecające tego typu."

#: includes/queries/class-referrers-query.php:137
msgid "Referrer name, such as Google or Direct."
msgstr "Nazwa źródła odesłania, np. Google lub Bezpośredni."

#: includes/queries/class-referrers-query.php:141
msgid "Referring domain; empty for Direct."
msgstr "Domena odsyłająca; puste w przypadku ruchu bezpośredniego."

#: includes/queries/class-site-summary-query.php:48
msgctxt "ability label; website traffic totals"
msgid "Site summary"
msgstr "Podsumowanie strony"

#: includes/queries/class-site-summary-query.php:59
msgid "Site-wide totals from Independent Analytics for a date range: views, unique visitors, sessions, bounces, bounce rate, average session length and views per session. Figures match the Independent Analytics dashboard for the same range. Use compare=previous_year with period=year_to_date for year-on-year. Returns one row."
msgstr "Ogólne dane dla całej witryny z serwisu Independent Analytics dla określonego przedziału czasowego: wyświetlenia, unikalni użytkownicy, sesje, odwiedziny bez przeglądania innych stron, współczynnik odrzuceń, średni czas trwania sesji oraz liczba wyświetleń na sesję. Dane są zgodne z danymi z pulpitu nawigacyjnego serwisu Independent Analytics dla tego samego przedziału czasowego. Aby uzyskać dane w ujęciu rok do roku, należy użyć parametru compare=previous_year wraz z parametrem period=year_to_date. Zwraca jeden wiersz."

#: includes/queries/class-site-summary-query.php:124
msgid "Single-view sessions as a percentage of sessions, rounded as on the dashboard."
msgstr "Sesje z jednym widokiem jako odsetek wszystkich sesji, zaokrąglone tak jak na pulpicie nawigacyjnym."

#: includes/queries/class-top-posts-query.php:48
msgctxt "ability label; most-visited blog posts and pages"
msgid "Top posts"
msgstr "Najpopularniejsze wpisy"

#: includes/queries/class-top-posts-query.php:59
msgid "Posts, pages, products and other singular content ranked by views, visitors or sessions for a date range, from Independent Analytics. Each row has the post ID, title, post type, absolute URL and path; the URL is the key to match against Google Search Console page data. Figures match the dashboard's Pages table. Visitors are unique per row and must not be summed across rows. Paged: check meta.pagination.has_more."
msgstr "Wpisy, strony, produkty i inne pojedyncze treści uszeregowane według liczby wyświetleń, odwiedzających lub sesji w danym przedziale czasowym, na podstawie danych z serwisu Independent Analytics. Każdy wiersz zawiera identyfikator wpisu, tytuł, typ wpisu, bezwzględny adres URL oraz ścieżkę; adres URL służy jako klucz do porównania z danymi stron w Google Search Console. Dane liczbowe odpowiadają tabeli „Strony” na pulpicie nawigacyjnym. Liczba odwiedzających jest unikalna dla każdego wiersza i nie wolno jej sumować między wierszami. Stronowanie: sprawdź meta.pagination.has_more."

#: includes/queries/class-top-posts-query.php:85
msgid "Only this post type, such as post, page or product. Omit for all."
msgstr "Tylko ten typ wpisu, np. wpis, strona lub produkt. Pomiń, aby uwzględnić wszystkie."

#: includes/queries/class-top-posts-query.php:90
msgid "Only posts in this category, by term ID."
msgstr "Tylko wpisy z tej kategorii, według identyfikatora terminu."

#. translators: %s: post type name.
#: includes/class-resource-query.php:184
#: includes/queries/class-top-posts-query.php:143
#, php-format
msgid "There is no post type called %s on this site."
msgstr "W tej witrynie nie ma typu wpisu o nazwie %s."

#: includes/queries/class-traffic-over-time-query.php:48
msgctxt "ability label; website visits per day, week or month"
msgid "Traffic over time"
msgstr "Ruch w czasie"

#: includes/queries/class-traffic-over-time-query.php:59
msgid "Views, unique visitors and sessions per day, week or month across a date range, from Independent Analytics, matching the dashboard chart. Every bucket in the range is present, with zeros where there was no traffic. Visitors are unique within each bucket and must not be summed across buckets; use site-summary for range totals. With compare, previous_rows holds the same series for the comparison range."
msgstr "Liczba wyświetleń, unikalnych użytkowników i sesji dziennie, tygodniowo lub miesięcznie w danym przedziale czasowym, pochodząca z serwisu Independent Analytics, zgodna z wykresem na pulpicie nawigacyjnym. Uwzględniono każdy przedział w tym zakresie, a tam, gdzie nie odnotowano ruchu, podano wartość zerową. Użytkownicy są unikalni w obrębie każdego przedziału i nie wolno ich sumować między przedziałami; w celu uzyskania sum dla całego zakresu należy skorzystać z podsumowania witryny. W przypadku funkcji „porównaj” (compare) zmienna `previous_rows` zawiera tę samą serię dla zakresu porównawczego."

#: includes/queries/class-traffic-over-time-query.php:86
msgid "Bucket size. Weeks start on the day set in Independent Analytics."
msgstr "Wielkość puli. Tygodnie rozpoczynają się w dniu ustawionym w module „Independent Analytics”."

#: includes/queries/class-traffic-over-time-query.php:105
msgid "First day of the bucket, Y-m-d, site timezone."
msgstr "Pierwszy dzień okresu rozliczeniowego, Y-m-d, strefa czasowa serwisu."

#: includes/class-resource-query.php:105
msgid "Metric to rank by, highest first. entrances counts sessions that started on the page; exits counts sessions that ended on it."
msgstr "Wskaźnik, według którego ma być tworzony ranking, od najwyższego. Liczba wejść obejmuje sesje, które rozpoczęły się na tej stronie; liczba wyjść obejmuje sesje, które się na niej zakończyły."

#: includes/class-resource-query.php:113
msgid "Only pages of this kind: singular (posts, pages, products), home, post_type_archive, term_archive (category and tag pages), author_archive, date_archive, search, 404 or virtual_page. Omit for all."
msgstr "Tylko strony tego rodzaju: pojedyncze (wpisy, strony, produkty), strona główna, archiwum typu wpisu, archiwum terminów (strony kategorii i tagów), archiwum autora, archiwum dat, wyszukiwanie, strona 404 lub strona wirtualna. Pomiń dla wszystkich."

#: includes/class-resource-query.php:118
msgid "Only singular pages of this post type, such as post or product."
msgstr "Tylko pojedyncze strony tego typu, takie jak wpis lub produkt."

#: includes/class-resource-query.php:123
msgid "Only the page with exactly this absolute URL, as Independent Analytics recorded it."
msgstr "Tylko strona o dokładnie tym adresie URL w formacie bezwzględnym, zgodnie z danymi zarejestrowanymi przez Independent Analytics."

#: includes/class-resource-query.php:150
msgid "Post ID for singular pages; null otherwise."
msgstr "Identyfikator wpisu dla pojedynczych stron; w pozostałych przypadkach wartość null."

#: includes/class-resource-query.php:155
msgid "What the visitor searched for, on search pages."
msgstr "Co użytkownik wyszukiwał na stronach wyszukiwania."

#: includes/class-resource-query.php:159
msgid "The requested path, on 404 pages."
msgstr "Żądana ścieżka na stronach 404."

#: includes/class-resource-query.php:365
msgid "Exits as a percentage of views."
msgstr "Odsetek wyjść w stosunku do liczby wyświetleń."

#: includes/class-resource-query.php:371
msgid "Average time on the page before the next view in the same session; null when no view had a next view."
msgstr "Średni czas spędzony na stronie przed wyświetleniem kolejnej strony w tej samej sesji; wartość null, jeśli żadne wyświetlenie nie miało następnego wyświetlenia."

#: includes/queries/class-landing-pages-query.php:40
msgctxt "ability label; pages where visits start"
msgid "Landing pages"
msgstr "Strony docelowe"

#: includes/queries/class-landing-pages-query.php:51
msgid "The pages where visits start, for a date range, from Independent Analytics: pages ranked by entrances (sessions that began on the page), with the same fields as top-pages. Useful alongside Google Search Console, which reports the landing page for search clicks. Only pages with at least one entrance are listed. Paged."
msgstr "Strony, z których rozpoczynają się wizyty w danym przedziale czasowym, według danych z Independent Analytics: strony uszeregowane według liczby wejść (sesji, które rozpoczęły się na danej stronie), z tymi samymi polami co w przypadku najpopularniejszych stron. Przydatne w połączeniu z Google Search Console, która podaje stronę docelową dla kliknięć w wynikach wyszukiwania. Wyświetlane są wyłącznie strony, na które odnotowano co najmniej jedno wejście. Wyniki są podzielone na strony."

#: includes/queries/class-not-found-query.php:40
msgctxt "ability label; requested addresses that returned a 404 error"
msgid "Not found pages"
msgstr "Strony „Nie znaleziono”"

#: includes/queries/class-not-found-query.php:51
msgid "Requested URLs that returned a 404 Not Found error, for a date range, from Independent Analytics: one row per requested path (not_found_url) with views, visitors and sessions. Shows broken links and pages visitors expect to exist, which may need a redirect or new content. Paged."
msgstr "Adresy URL, do których wysłano żądania i które zwróciły błąd 404 Not Found w danym przedziale czasowym, według danych z serwisu Independent Analytics: jeden wiersz na każdą ścieżkę, do której wysłano żądanie (not_found_url), wraz z liczbą wyświetleń, odwiedzających i sesji. Pokazuje niedziałające linki oraz strony, których istnienia oczekują odwiedzający, a które mogą wymagać przekierowania lub nowej treści. Dane są podzielone na strony."

#: includes/queries/class-page-stats-query.php:62
msgctxt "ability label; traffic figures for one web page"
msgid "Page stats"
msgstr "Statystyki strony"

#: includes/queries/class-page-stats-query.php:73
msgid "One page in detail, for a date range, from Independent Analytics. Give post_id, or the page's absolute url (for example from Google Search Console). Returns one row with the same fields as top-pages, and series: views, visitors and sessions for that page per day, week or month (interval). With compare, the row carries previous figures and previous_series holds the comparison series. Errors with iawpqh_unknown_page if Independent Analytics has never recorded the page."
msgstr "Szczegółowe dane dotyczące jednej strony w wybranym przedziale czasowym, pochodzące z serwisu Independent Analytics. Należy podać identyfikator post_id lub bezwzględny adres URL strony (na przykład z Google Search Console). Zwraca jeden wiersz zawierający te same pola co w przypadku top-pages oraz serie: wyświetlenia, odwiedzających i sesji dla tej strony w ujęciu dziennym, tygodniowym lub miesięcznym (interwał). W przypadku użycia opcji compare wiersz zawiera poprzednie wartości, a pole previous_series zawiera serie porównawcze. W przypadku, gdy Independent Analytics nigdy nie zarejestrowało tej strony, zwracany jest błąd typu iawpqh_unknown_page."

#: includes/queries/class-page-stats-query.php:99
msgid "The post, page or product ID. Give this or url."
msgstr "Identyfikator wpisu, strony lub produktu. Podaj ten identyfikator lub adres URL."

#: includes/queries/class-page-stats-query.php:104
msgid "The page's absolute URL, as Independent Analytics recorded it. Give this or post_id."
msgstr "Bezwzględny adres URL strony, zgodnie z danymi zarejestrowanymi przez Independent Analytics. Należy podać ten adres lub identyfikator post_id."

#: includes/queries/class-page-stats-query.php:203
msgid "Give exactly one of post_id or url."
msgstr "Należy podać dokładnie jedną z wartości: „post_id” lub „url”."

#: includes/queries/class-page-stats-query.php:218
msgid "Independent Analytics has no record of that page."
msgstr "W serwisie Independent Analytics nie ma żadnych danych dotyczących tej strony."

#: includes/queries/class-site-searches-query.php:40
msgctxt "ability label; terms visitors typed into the site search box"
msgid "Site searches"
msgstr "Wyszukiwania na stronie"

#: includes/queries/class-site-searches-query.php:51
msgid "What visitors searched for using the site's own search box, for a date range, from Independent Analytics: one row per search term (search_query) with views, visitors, sessions, exits and bounce rate. A strong source of content ideas: frequent searches show what visitors expect to find. Paged."
msgstr "Co użytkownicy wyszukiwali za pomocą własnej wyszukiwarki serwisu w wybranym przedziale czasowym – dane z Independent Analytics: jeden wiersz na każdy termin wyszukiwania (search_query) wraz z liczbą wyświetleń, odwiedzających, sesji, wyjść i współczynnikiem odrzuceń. Doskonałe źródło pomysłów na treści: częste wyszukiwania pokazują, czego użytkownicy oczekują. Stronicowanie."

#: includes/queries/class-top-pages-query.php:40
msgctxt "ability label; most-visited pages of any kind"
msgid "Top pages"
msgstr "Najpopularniejsze strony"

#: includes/queries/class-top-pages-query.php:51
msgid "Every kind of page Independent Analytics records (posts, pages, products, the home page, category and tag archives, search results, 404s) ranked by views, visitors, sessions, entrances or exits for a date range. Each row has the page title, absolute URL, path, kind and, for posts, the post ID and post type, plus views, visitors, sessions, entrances, exits, exit rate, bounces, bounce rate, views per session and average time on page. Matches the dashboard's Pages table. Filter with resource_type, post_type or an exact url (for example a URL from Google Search Console). Visitors must not be summed across rows. Paged."
msgstr "Wszystkie rodzaje stron rejestrowane przez Independent Analytics (wpisy, strony, produkty, strona główna, archiwa kategorii i tagów, wyniki wyszukiwania, strony 404) uszeregowane według liczby wyświetleń, odwiedzających, sesji, wejść lub wyjść w danym przedziale czasowym. Każdy wiersz zawiera tytuł strony, bezwzględny adres URL, ścieżkę, rodzaj oraz – w przypadku wpisów – identyfikator i typ wpisu, a także liczbę wyświetleń, odwiedzających, sesji, wejść, wyjść, współczynnik wyjść, odbić, współczynnik odrzuceń, liczbę wyświetleń na sesję oraz średni czas spędzony na stronie. Odpowiada tabeli „Strony” na pulpicie nawigacyjnym. Filtruj według resource_type, post_type lub dokładnego adresu URL (na przykład adresu z Google Search Console). Liczba odwiedzających nie może być sumowana w różnych wierszach. Stronicowanie."

#: includes/class-revenue-query.php:137
msgid "Order metric to rank by, highest first."
msgstr "Uporządkuj dane według tego wskaźnika, zaczynając od najwyższych wartości."

#: includes/class-revenue-query.php:157
msgid "Gross sales less refunds, in the store currency (meta.currency), major units."
msgstr "Sprzedaż brutto pomniejszona o zwroty, w walucie sklepu (meta.currency), w jednostkach podstawowych."

#: includes/class-revenue-query.php:161
msgid "Orders as a percentage of visitors."
msgstr "Liczba zamówień jako odsetek odwiedzających."

#: includes/class-revenue-query.php:166
msgid "Gross sales divided by orders."
msgstr "Sprzedaż brutto podzielona przez liczbę zamówień."

#: includes/queries/class-ecommerce-summary-query.php:48
msgctxt "ability label; shop sales totals"
msgid "Ecommerce summary"
msgstr "Podsumowanie sprzedaży internetowej"

#: includes/queries/class-ecommerce-summary-query.php:59
msgid "Site-wide WooCommerce totals for a date range, from Independent Analytics Pro: orders, gross sales, refunds, refunded amount, net sales, conversion rate (orders per visitor), earnings per visitor and average order value, with visitors. Money is in the store currency (the currency field) in major units. Matches the ecommerce figures on the dashboard. Use compare=previous_year with period=year_to_date for year-on-year. Returns one row."
msgstr "Ogólne dane WooCommerce dla całego serwisu w wybranym przedziale czasowym, pochodzące z Independent Analytics Pro: zamówienia, sprzedaż brutto, zwroty, kwota zwrotów, sprzedaż netto, współczynnik konwersji (liczba zamówień na odwiedzającego), przychód na odwiedzającego oraz średnia wartość zamówienia, wraz z liczbą odwiedzających. Kwoty są podane w walucie sklepu (pole „waluta”) w głównych jednostkach. Dane te odpowiadają danym e-commerce widocznym na pulpicie nawigacyjnym. Aby uzyskać dane w ujęciu rok do roku, należy użyć parametru compare=previous_year wraz z period=year_to_date. Zwraca jeden wiersz."

#: includes/queries/class-ecommerce-summary-query.php:99
msgid "Store base currency, ISO 4217."
msgstr "Waluta bazowa sklepu, ISO 4217."

#: includes/queries/class-revenue-by-campaign-query.php:40
msgctxt "ability label; shop sales grouped by marketing campaign"
msgid "Revenue by campaign"
msgstr "Przychody według kampanii"

#: includes/queries/class-revenue-by-campaign-query.php:51
msgid "WooCommerce orders and sales from UTM-tagged campaign traffic for a date range, from Independent Analytics Pro. dimension chooses whole campaigns or one UTM parameter, as in the campaigns query. Each row has orders, gross sales, refunds, net sales, conversion rate, earnings per visitor and average order value, plus visitors and sessions. Money is in the store currency (meta.currency) in major units. Only campaigns with at least one order are listed, ranked by net sales. Paged."
msgstr "Zamówienia i sprzedaż w WooCommerce pochodzące z ruchu kampanii oznaczonego tagami UTM dla wybranego przedziału czasowego, na podstawie danych z Independent Analytics Pro. W wymiarze można wybrać całe kampanie lub jeden parametr UTM, tak jak w zapytaniu dotyczącym kampanii. Każdy wiersz zawiera zamówienia, sprzedaż brutto, zwroty, sprzedaż netto, współczynnik konwersji, przychód na odwiedzającego i średnią wartość zamówienia, a także liczbę odwiedzających i sesji. Kwoty są podane w walucie sklepu (meta.currency) w głównych jednostkach. Wyświetlane są wyłącznie kampanie, w ramach których złożono co najmniej jedno zamówienie, uszeregowane według sprzedaży netto. Stronicowanie."

#: includes/queries/class-revenue-by-landing-page-query.php:62
msgctxt "ability label; shop sales grouped by the page where the visit started"
msgid "Revenue by landing page"
msgstr "Przychody według strony docelowej"

#: includes/queries/class-revenue-by-landing-page-query.php:73
msgid "WooCommerce orders and sales by landing page for a date range, from Independent Analytics Pro: the page each ordering visit started on, with its title, URL and kind, plus orders, gross sales, refunds, net sales, conversion rate, earnings per visitor and average order value, and the page's visitors and sessions. Money is in the store currency (meta.currency) in major units. Matches the ecommerce columns of the dashboard's Pages table. Pair with Google Search Console landing pages to see which search traffic earns money. Only pages with at least one order are listed, ranked by net sales. Paged."
msgstr "Zamówienia i sprzedaż w WooCommerce według stron docelowych w wybranym przedziale czasowym, na podstawie danych z Independent Analytics Pro: strona, od której rozpoczęła się każda wizyta zakończona zamówieniem, wraz z jej tytułem, adresem URL i typem, a także liczba zamówień, sprzedaż brutto, zwroty, sprzedaż netto, współczynnik konwersji, przychód na odwiedzającego i średnia wartość zamówienia, a także liczba odwiedzających i sesji na tej stronie. Kwoty podane są w walucie sklepu (meta.currency) w głównych jednostkach. Dane odpowiadają kolumnom e-commerce w tabeli „Strony” na pulpicie nawigacyjnym. Porównaj je ze stronami docelowymi w Google Search Console, aby sprawdzić, który ruch z wyszukiwarek generuje przychody. Wyświetlane są wyłącznie strony, na których złożono co najmniej jedno zamówienie, uszeregowane według sprzedaży netto. Strony są podzielone na strony."

#: includes/queries/class-revenue-by-referrer-query.php:40
msgctxt "ability label; shop sales grouped by the website that sent the visitor"
msgid "Revenue by referrer"
msgstr "Przychody według źródła odesłania"

#: includes/queries/class-revenue-by-referrer-query.php:51
msgid "WooCommerce orders and sales by traffic source for a date range, from Independent Analytics Pro: each referrer (Google, Facebook, Direct...) with orders, gross sales, refunds, net sales, conversion rate, earnings per visitor and average order value, plus its visitors and sessions. Money is in the store currency (meta.currency) in major units. Matches the ecommerce columns of the dashboard's Referrers table. Only referrers with at least one order are listed, ranked by net sales. Filter with referrer_type. Paged."
msgstr "Zamówienia i sprzedaż w WooCommerce według źródła ruchu w wybranym przedziale czasowym, na podstawie danych z Independent Analytics Pro: każde źródło ruchu (Google, Facebook, bezpośrednie wejście...) wraz z liczbą zamówień, sprzedażą brutto, zwrotami, sprzedażą netto, współczynnikiem konwersji, przychodem na odwiedzającego oraz średnią wartością zamówienia, a także liczbą odwiedzających i sesji. Kwoty podane są w walucie sklepu (meta.currency) w głównych jednostkach. Dane odpowiadają kolumnom e-commerce w tabeli „Źródła ruchu” na pulpicie nawigacyjnym. Wyświetlane są wyłącznie źródła ruchu, które wygenerowały co najmniej jedno zamówienie, uszeregowane według sprzedaży netto. Możliwość filtrowania według referrer_type. Stronicowanie."

#: includes/class-form-breakdown-query.php:129
msgid "Only count submissions of this form (form_id from the form-submissions query)."
msgstr "Należy uwzględnić wyłącznie zgłoszenia z tego formularza (identyfikator form_id z zapytania dotyczącego zgłoszeń z formularzy)."

#: includes/class-form-breakdown-query.php:147
msgid "Submissions as a percentage of this row's visitors."
msgstr "Liczba zgłoszeń jako odsetek odwiedzających tę stronę."

#: includes/class-query.php:238
msgid "Continue from the previous page: pass meta.pagination.next_cursor unchanged. Omit for the first page."
msgstr "Kontynuacja z poprzedniej strony: należy przekazać wartość meta.pagination.next_cursor bez zmian. W przypadku pierwszej strony należy pominąć tę wartość."

#: includes/queries/class-form-submissions-by-campaign-query.php:40
msgctxt "ability label; contact form entries grouped by marketing campaign"
msgid "Form submissions by campaign"
msgstr "Przesłane formularze według kampanii"

#: includes/queries/class-form-submissions-by-campaign-query.php:51
msgid "Form submissions from UTM-tagged campaign traffic for a date range, from Independent Analytics Pro. dimension chooses whole campaigns or one UTM parameter, as in the campaigns query. Each row has submissions, conversion rate (submissions as a percentage of the row's visitors), visitors and sessions. Filter with form_id (from the form-submissions query). Only campaigns with at least one submission are listed, most first. Paged."
msgstr "Przesłane formularze z ruchu kampanii oznaczonego tagami UTM dla danego przedziału czasowego, pochodzące z Independent Analytics Pro. W wymiarze można wybrać całe kampanie lub jeden parametr UTM, tak jak w zapytaniu dotyczącym kampanii. Każdy wiersz zawiera liczbę przesłanych formularzy, współczynnik konwersji (odsetek przesłanych formularzy w stosunku do liczby odwiedzających w danym wierszu), liczbę odwiedzających oraz liczbę sesji. Filtrowanie według form_id (z zapytania dotyczącego przesłanych formularzy). Wyświetlane są tylko kampanie z co najmniej jednym przesłanym formularzem, zaczynając od tych z największą liczbą przesłanych formularzy. Stronicowanie."

#: includes/queries/class-form-submissions-by-page-query.php:62
msgctxt "ability label; contact form entries grouped by web page"
msgid "Form submissions by page"
msgstr "Przesłane formularze według stron"

#: includes/queries/class-form-submissions-by-page-query.php:73
msgid "Form submissions by page for a date range, from Independent Analytics Pro: the page each form was submitted on, with its title, URL and kind, plus submissions, conversion rate (submissions as a percentage of the page's visitors), and the page's visitors and sessions. Matches the form columns of the dashboard's Pages table. Filter with form_id (from the form-submissions query). Only pages with at least one submission are listed, most first. Paged."
msgstr "Przesłane formularze według stron w danym przedziale czasowym, z serwisu Independent Analytics Pro: strona, na której każdy formularz został przesłany, wraz z jej tytułem, adresem URL i typem, a także liczbą przesłanych formularzy, współczynnikiem konwersji (odsetek przesłanych formularzy w stosunku do liczby odwiedzających stronę) oraz liczbą odwiedzających i sesji na tej stronie. Odpowiada kolumnom formularza w tabeli „Strony” na pulpicie nawigacyjnym. Filtrowanie według form_id (z zapytania dotyczącego przesłanych formularzy). Wyświetlane są tylko strony z co najmniej jednym przesłaniem, zaczynając od tych z największą liczbą przesłań. Stronicowanie."

#: includes/queries/class-form-submissions-by-referrer-query.php:40
msgctxt "ability label; contact form entries grouped by the website that sent the visitor"
msgid "Form submissions by referrer"
msgstr "Przesłane formularze według źródła odesłania"

#: includes/queries/class-form-submissions-by-referrer-query.php:51
msgid "Form submissions by traffic source for a date range, from Independent Analytics Pro: each referrer (Google, Facebook, Direct...) with submissions, conversion rate (submissions as a percentage of the referrer's visitors), visitors and sessions. Matches the form columns of the dashboard's Referrers table. Filter with form_id (from the form-submissions query) and referrer_type. Only referrers with at least one submission are listed, most first. Paged."
msgstr "Przesłane formularze według źródła ruchu w danym przedziale czasowym, na podstawie danych z Independent Analytics Pro: każde źródło odesłania (Google, Facebook, Bezpośredni...) wraz z liczbą przesłanych formularzy, współczynnikiem konwersji (odsetek przesłanych formularzy wśród odwiedzających z danego źródła), liczbą odwiedzających i sesji. Odpowiada kolumnom formularza w tabeli „Źródła ruchu” na pulpicie nawigacyjnym. Filtrowanie według form_id (z zapytania dotyczącego przesłanych formularzy) oraz referrer_type. Wyświetlane są wyłącznie źródła ruchu, które mają co najmniej jedno przesłanie, przy czym najpierw wyświetlane są te z największą liczbą przesłań. Stronicowanie."

#: includes/queries/class-form-submissions-query.php:48
msgctxt "ability label; contact form entries"
msgid "Form submissions"
msgstr "Przesłane formularze"

#: includes/queries/class-form-submissions-query.php:59
msgid "Form submissions tracked by Independent Analytics Pro for a date range, one row per form (contact forms, sign-ups and similar from the supported form plugins), with submissions and conversion rate (submissions as a percentage of all site visitors). The totals object holds the site-wide figures and the visitor count. Matches the form figures on the dashboard. Every tracked form is listed, including those with no submissions in the range. Use compare=previous_year with period=year_to_date for year-on-year."
msgstr "Dane dotyczące przesłanych formularzy śledzone przez Independent Analytics Pro dla danego przedziału czasowego, po jednym wierszu na formularz (formularze kontaktowe, rejestracje i podobne z obsługiwanych wtyczek formularzy), wraz z liczbą przesłanych formularzy i współczynnikiem konwersji (liczba przesłanych formularzy jako procent wszystkich odwiedzających witrynę). Obiekt „sumy” zawiera dane ogólnowitrynowe oraz liczbę odwiedzających. Dane te odpowiadają danym dotyczącym formularzy na pulpicie nawigacyjnym. Wymienione są wszystkie śledzone formularze, w tym te, które nie miały żadnych przesłanych danych w danym przedziale czasowym. Aby uzyskać dane w ujęciu rok do roku, należy użyć parametru „compare=previous_year” wraz z parametrem „period=year_to_date”."

#: includes/queries/class-form-submissions-query.php:89
msgid "Independent Analytics form ID, for the form_id filter of the other form queries."
msgstr "Identyfikator formularza Independent Analytics, służący jako filtr „form_id” w zapytaniach dotyczących innych formularzy."

#: includes/queries/class-form-submissions-query.php:112
msgid "Site-wide submissions, conversion rate and visitors."
msgstr "Dane dotyczące całej witryny: zgłoszenia, współczynnik konwersji i liczba odwiedzających."

#: includes/queries/class-form-submissions-query.php:163
msgid "Submissions as a percentage of site visitors."
msgstr "Liczba zgłoszeń jako odsetek odwiedzających stronę."

#: includes/queries/class-raw-views-query.php:40
msgctxt "ability label; list of individual page views"
msgid "Raw views"
msgstr "Wyświetlenia surowe"

#. translators: %d: maximum days in one range.
#: includes/queries/class-raw-views-query.php:53
#, php-format
msgid "Individual page views from Independent Analytics, oldest first: when each view happened (UTC and site time), the page (title, URL, kind, post ID and type), the visit's referrer and referrer type, country code, device type, and whether the view started the visit. Views are those viewed within the range, so totals can differ slightly from the dashboard at the edges of a range. There are no visitor or session identifiers. Ranges are limited to %d days. Prefer the grouped queries for totals and rankings; use this only when individual views are needed. Page through with cursor: pass meta.pagination.next_cursor until has_more is false."
msgstr "Indywidualne wyświetlenia stron z Independent Analytics, najstarsze na początku: kiedy miało miejsce każde wyświetlenie (czas UTC i czas serwisu), strona (tytuł, adres URL, rodzaj, identyfikator i typ wpisu), strona odsyłająca i typ odsyłacza, kod kraju, typ urządzenia oraz informacja, czy wyświetlenie zainicjowało wizytę. Wyświetlenia to te, które miały miejsce w danym przedziale, więc sumy mogą nieznacznie różnić się od danych na pulpicie nawigacyjnym na granicach przedziału. Nie ma identyfikatorów odwiedzających ani sesji. Przedziały są ograniczone do %d dni. Do sum i rankingów lepiej używać zapytań zgrupowanych; z tej opcji korzystaj tylko wtedy, gdy potrzebne są pojedyncze wyświetlenia. Przeglądaj za pomocą kursora: przekazuj `meta.pagination.next_cursor`, dopóki `has_more` nie przyjmie wartości false."

#: includes/queries/class-raw-views-query.php:107
msgid "UTC, ISO 8601."
msgstr "UTC, ISO 8601."

#: includes/queries/class-raw-views-query.php:111
msgid "Site time, Y-m-d H:i:s."
msgstr "Czas na stronie, Y-m-d H:i:s."

#: includes/queries/class-raw-views-query.php:128
msgid "Whether this was the first view of its visit."
msgstr "Czy było to pierwsze spojrzenie podczas tej wizyty."

#: includes/queries/class-raw-views-query.php:146
msgid "That cursor is not valid. Pass meta.pagination.next_cursor unchanged, or omit it for the first page."
msgstr "Ten kursor jest nieprawidłowy. Należy przekazać parametr `meta.pagination.next_cursor` bez zmian lub pominąć go w przypadku pierwszej strony."
